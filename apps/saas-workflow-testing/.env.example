PORT=3000
NODE_ENV=development

# Demo-safe default. Generates premium-style review output without a network call.
REVIEW_PROVIDER_MODE=simulated-paid
AI_TIMEOUT_MS=8000

# Optional paid OpenAI-compatible review provider.
PAID_AI_BASE_URL=
PAID_AI_API_KEY=
PAID_AI_MODEL=
PAID_AI_LABEL=Paid OpenAI-Compatible Review API

# Optional free-tier OpenAI-compatible review provider.
# Use the base URL without /chat/completions; the app appends it automatically.
FREE_AI_BASE_URL=
FREE_AI_API_KEY=
FREE_AI_MODEL=
FREE_AI_LABEL=Free-Tier OpenAI-Compatible Review API
