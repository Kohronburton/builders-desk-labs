  "placeholders": [
    "PLACEHOLDER_PACKAGE_CATALOGUE",
    "PLACEHOLDER_SEGMENTATION_RULES",
    "PLACEHOLDER_WORDPRESS_UPLOAD_HOSTS",
    "PLACEHOLDER_RETENTION_POLICY"
  ]
}
