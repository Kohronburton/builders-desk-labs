{
  "id": "private-paid-order-backend",
  "name": "Private Paid-Order Backend",
  "version": "2.1.0",
  "maturity": "production-candidate",
  "description": "Secure paid-order intake, private asset handling, job creation, and operator-safe production views.",
  "capabilities": [
    "signed-webhook-intake",
    "replay-protection",
    "idempotent-order-processing",
    "script-segmentation",
    "private-asset-ingestion",
    "operator-job-views"
  ],
  "foundation": [
    "configuration",
    "logging",
    "events",
    "health",
    "testing"
  ],
  "owns": [
    "Customer",
    "Order",
    "ProductionJob",
    "Script",
    "ScriptSegment",
    "UploadedAsset",
    "WebhookAttempt"
