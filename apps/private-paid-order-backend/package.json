{
  "name": "@builders-desk/private-paid-order-backend",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
