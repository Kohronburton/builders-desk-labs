{
  "name": "@builders-desk/private-paid-order-backend",
  "version": "2.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "dev:worker": "tsx src/worker.ts",
    "migrate": "tsx scripts/migrate.ts",
    "db:smoke": "tsx scripts/db-smoke.ts",
    "db:backup": "tsx scripts/backup-db.ts",
    "db:restore-test": "tsx scripts/restore-test.ts",
    "user:create": "tsx scripts/create-user.ts",
    "webhook:simulate": "tsx scripts/simulate-webhook.ts",
    "load:test": "tsx scripts/load-test.ts",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test test/**/*.test.ts",
    "check": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/s3-request-presigner": "^3.750.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@mayne/foundation-core": "workspace:*",
    "@mayne/module-sdk": "workspace:*",
    "fastify": "^5.2.1",
    "file-type": "^20.1.0",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
