NODE_ENV=development
PORT=3100
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/paid_orders
REDIS_URL=redis://localhost:6379

WORDPRESS_WEBHOOK_KEY_PRIMARY_ID=local-primary
WORDPRESS_WEBHOOK_KEY_PRIMARY_SECRET=PLACEHOLDER_GENERATE_A_32_BYTE_SECRET
WORDPRESS_WEBHOOK_KEY_SECONDARY_ID=
WORDPRESS_WEBHOOK_KEY_SECONDARY_SECRET=
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
WEBHOOK_NONCE_TTL_SECONDS=900

OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=paid-order-assets
OBJECT_STORAGE_ACCESS_KEY=PLACEHOLDER_LOCAL_ONLY
OBJECT_STORAGE_SECRET_KEY=PLACEHOLDER_LOCAL_ONLY
SIGNED_URL_TTL_SECONDS=600
MAX_UPLOAD_SIZE_BYTES=26214400
WORDPRESS_ALLOWED_FILE_HOSTS=PLACEHOLDER_WORDPRESS_UPLOAD_HOSTS
DEFAULT_ASSET_RETENTION_DAYS=PLACEHOLDER_RETENTION_POLICY

LOG_LEVEL=info
