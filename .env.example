# One or more repository roots Claude may operate on.
# Windows: separate paths with semicolons. macOS/Linux: commas also work.
CLAUDE_GITHUB_ALLOWED_REPOS=C:\\code\\project-one;C:\\code\\project-two

# Direct commits/pushes/merges into these branches are blocked by default.
CLAUDE_GITHUB_PROTECTED_BRANCHES=main,master,develop,production
CLAUDE_GITHUB_ALLOW_PROTECTED_WRITES=false

# Optional. Used by GitHub CLI for pull-request creation and merging.
GH_TOKEN=

# HTTP transport for the Claude web app / remote connector mode.
PORT=3000
MCP_BEARER_TOKEN=replace-with-a-long-random-secret
